# Bedrock vía API key temporal (bearer token), generada desde la consola de AWS
# Bedrock con MFA. Dura ~12h — regenérala cada día de trabajo. En ECS no haría
# falta nada de esto: usaría el rol de la tarea.
CLAUDE_CODE_USE_BEDROCK=1
AWS_REGION=us-east-2
AWS_BEARER_TOKEN_BEDROCK=

# Qué modelo real usa cada alias ("sonnet", "haiku") en Bedrock.
# Son los perfiles globales que ya usa el orchestrator; confírmalos.
ANTHROPIC_DEFAULT_SONNET_MODEL=global.anthropic.claude-sonnet-4-5-20250929-v1:0
ANTHROPIC_DEFAULT_HAIKU_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0

# Gmail (OAuth client tipo "Web application", scopes gmail.readonly + gmail.send)
# Ver docs/conectores.md para el flujo paso a paso en Google Cloud Console.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:5174/api/conectores/gmail/callback

# Slack (Bot User OAuth Token, xoxb-...). Ver slack-app-manifest.yaml.
SLACK_BOT_TOKEN=
